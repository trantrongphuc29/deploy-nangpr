# Sao chép file này thành .env và điền giá trị thật (KHÔNG commit .env)

# ---- Cloudinary (upload ảnh món) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Database (MySQL / TiDB Cloud) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quan_cafe
# Đặt true khi kết nối TiDB Cloud (yêu cầu TLS)
DB_SSL=false

# ---- Auth ----
SECRET_KEY=your_secret_key
